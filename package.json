    "format": "prettier --check \"src/**/*.{ts,css}\"",
    "images": "node scripts/build-images.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "gsap": "^3.15.1",
    "three": "^0.187.0"
  },
  "private": true,
  "type": "module"
