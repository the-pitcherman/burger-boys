{
  "name": "burger-boys",
  "version": "2.0.0",
  "description": "Burger Boys — plant-based smash burger website",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
